# MySQL connection used by the Spring Boot backend.
DB_URL=jdbc:mysql://localhost:3306/library_seat?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=library_seat
DB_PASSWORD=replace-with-a-strong-database-password

# HS256 signing key. Use a random value of at least 32 UTF-8 bytes.
# Generate one with:
#   openssl rand -hex 32
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes

# Optional backend port.
SERVER_PORT=8080

# Docker Compose development database settings.
MYSQL_DATABASE=library_seat
MYSQL_USER=library_seat
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_PORT=3306
