@startuml
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Microsoft YaHei"
skinparam defaultFontSize 15
skinparam dpi 200
skinparam shadowing false
skinparam ArrowColor #444444
skinparam activityBackgroundColor #FFFFFF
skinparam activityBorderColor #444444
skinparam swimlaneBorderColor #37474F
skinparam swimlaneTitleFontSize 15

title 座位查询与预约模块交互活动图

|读者|
start
:输入学号 / 工号与密码;
:选择阅览室、日期与时段;

|前端页面|
:校验筛选条件是否完整;

|后端服务|
:JWT 拦截器校验令牌;

|前端页面|
if (令牌有效?) then (否)
  |读者|
  :提示登录已过期;
  :重新登录;
  stop
else (是)
  |后端服务|
  :SeatService 查询阅览室与时段;
  :SeatService 查询座位并标记占用状态;
  |数据库|
  :SELECT 座位与有效预约记录;
  |前端页面|
  :渲染座位分布图;
  |读者|
  :浏览座位图并选择座位;
  :在确认对话框中确认预约;
  |前端页面|
  :提交预约请求 /api/reserve;
  |后端服务|
  :ReservationService 校验黑名单、座位状态与日期;
  if (基础校验通过?) then (否)
    |前端页面|
    :提示失败原因;
    |读者|
    :重新选择座位;
  else (是)
    |后端服务|
    :检测座位时段冲突与用户重复预约;
    if (存在冲突?) then (是)
      |前端页面|
      :提示"该座位已被预约";
      |读者|
      :返回座位图重新选座;
    else (否)
      |后端服务|
      :生成预约单号并写入预约记录;
      |数据库|
      :INSERT 预约记录;
      |前端页面|
      :提示"预约成功"并刷新座位图;
      |读者|
      :预约完成;
      stop
    endif
  endif
endif

@enduml
