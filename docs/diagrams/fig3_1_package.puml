@startuml
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Microsoft YaHei"
skinparam defaultFontSize 15
skinparam dpi 200
skinparam shadowing false
skinparam ArrowColor #444444
skinparam ArrowThickness 1.3
skinparam packageBorderColor #37474F
skinparam packageBackgroundColor #FFFFFF
skinparam componentBorderColor #515151
skinparam componentBackgroundColor #F4F7FB
skinparam databaseBackgroundColor #FFFFFF

package "用户界面层（View，Vue 3 单页应用）" {
  component "views/Login.vue\n登录页" as V1
  component "views/Home.vue\n选座预约页" as V2
  component "views/MyReservations.vue\n我的预约页" as V3
  component "views/Notices.vue\n馆内公告页" as V4
  component "router/index.js\n路由与登录守卫" as V5
  component "stores/user.js\n登录态（Pinia）" as V6
  component "api/request.js\nAxios 实例与拦截器" as V7
}

package "业务逻辑层（Controller / Service）" {
  component "controller.ApiController\nREST 接口入口" as B1
  component "service.SeatService\n阅览室/时段/座位查询" as B2
  component "service.ReservationService\n预约/取消/签到/签退" as B3
  component "service.NoticeService\n公告查询" as B4
  component "service.UserService\n登录校验" as B5
  component "util.JwtUtil + interceptor.JwtInterceptor\n令牌签发与鉴权" as B6
  component "common.Result\n统一响应封装" as B7
}

package "数据处理层（Mapper / Entity）" {
  component "mapper.*Mapper\nMyBatis 注解式 SQL 映射" as D1
  component "entity.*\n实体类（表映射）" as D2
  component "dto.*\nSeatVO / ReservationVO" as D3
}

database "MySQL 8.0\nlibrary_seat 数据库" as DB

V1 --> V7
V2 --> V7
V3 --> V7
V4 --> V7
V5 --> V6
V7 --> B1 : HTTP / JSON
B1 --> B7
B1 --> B2
B1 --> B3
B1 --> B4
B1 --> B5
B1 --> B6
B2 --> D1
B3 --> D1
B4 --> D1
B5 --> D1
D1 --> D2
D1 --> D3
D1 --> DB : JDBC

@enduml
